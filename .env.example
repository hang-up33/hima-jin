# ==========================================================================
# ヒマジン — 課金 / App Store Connect API 用の環境変数サンプル
# --------------------------------------------------------------------------
# このファイルをコピーして `.env` を作成し、実際の値を設定してください。
#   cp .env.example .env
# `.env` と *.p8 は .gitignore 済み。絶対にコミットしないこと。
# ==========================================================================

# --------------------------------------------------------------------------
# RevenueCat（アプリ内課金 SDK / Public SDK Key）
# RevenueCat ダッシュボード > Project settings > API keys > Public app-specific keys
# --------------------------------------------------------------------------
REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat REST API（サーバー側 / Webhook 検証などで使用）Secret key。
REVENUECAT_SECRET_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------------------
# App Store Connect API キー
# App Store Connect > ユーザーとアクセス > 統合 > App Store Connect API
#   - Key ID（10桁）
#   - Issuer ID（UUID）
#   - AuthKey_XXXXXXXXXX.p8（ダウンロードは一度のみ。プロジェクト直下に置く）
# --------------------------------------------------------------------------
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# CI 環境では .p8 の中身を base64 化して 1 行で渡すのが便利。
#   base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy
ASC_KEY_CONTENT_BASE64=

# --------------------------------------------------------------------------
# アプリ識別子
# --------------------------------------------------------------------------
APP_BUNDLE_ID=com.himajin.himaJin
APP_STORE_APP_ID=
DEVELOPER_TEAM_ID=9QG7B94N3U

# --------------------------------------------------------------------------
# GitHub Actions TestFlight 署名用 Secrets
# --------------------------------------------------------------------------
# .p12 と .mobileprovision は base64 化して testflight Environment の Secrets に登録。
#   base64 -i Certificates.p12 | pbcopy
#   base64 -i AppStore_Profile.mobileprovision | pbcopy
IOS_CERTIFICATE_BASE64=
IOS_CERTIFICATE_PASSWORD=
IOS_PROVISION_PROFILE_BASE64=
KEYCHAIN_PASSWORD=
